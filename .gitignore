# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Local audit and generated cache files.
/audit-*.png
/tsconfig.tsbuildinfo
/xlsx-read/
/doctor-sheet.webp
/hospital-sheet.webp

# Keep optimized web assets in Git; exclude unused source variants.
/public/images/hospitals/*.jpg
/public/images/hospitals/*.new
/public/images/hospitals/*.new2
/public/images/doctors/*.source
/public/images/shanghai-medical-concierge-hero-mobile.png
/public/images/shanghai-support/*.png
